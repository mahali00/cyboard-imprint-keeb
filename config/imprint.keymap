#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,matrix-transform = &imprint_number_row; };

    // -------------------------------------------------------------------------
    // Layer map:
    // 0 base_layer         typing, HRMs, and thumb layer access
    // 1 symbols_layer      symbols on left, light editing/navigation on right
    // 2 numbers_layer      F-keys and right-hand numpad
    // 3 system_layer       Bluetooth, output, RGB, Studio, reset/bootloader
    // 4 mouse_media_layer  left-hand mouse buttons, right-hand media controls
    // -------------------------------------------------------------------------
    // -------------------------------------------------------------------------
    // Behaviors
    // -------------------------------------------------------------------------

    behaviors {
        // Caps Word combo behavior.

        CAPSWord_v1: CAPSWord_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&kp>, <&caps_word>;
        };

        // Home-row mods are split by side/finger so each can tune timing and opposite-hand triggers.

        HRM_left_index_v1: HRM_left_index_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <100>;
            hold-trigger-key-positions = <45 44 43 60 61 62 4 5 6 7 8 16 17 18 19 20 28 29 30 31 32 46 47 48 49 50 63 9 21 33 51 40 41 42 58 59 57>;
            hold-trigger-on-release;
        };

        HRM_left_middy_v1: HRM_left_middy_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <45 44 43 60 61 62 4 5 6 7 8 16 17 18 19 20 28 29 30 31 32 46 47 48 49 50 63 9 21 33 51 40 41 42 57 58 59>;
            hold-trigger-on-release;
        };

        HRM_left_pinky_v1: HRM_left_pinky_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <45 44 43 60 61 62 4 5 6 7 8 9 17 18 19 20 21 30 31 32 33 48 49 50 51 16 28 29 46 47 63 40 41 42 57 58 59>;
            hold-trigger-on-release;
        };

        HRM_left_ring_v1: HRM_left_ring_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <45 44 43 60 61 62 4 5 6 7 8 16 17 18 19 20 28 29 30 31 32 46 47 48 49 50 63 9 21 33 51 40 41 42 57 58 59>;
            hold-trigger-on-release;
        };

        HRM_right_index_v1: HRM_right_index_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <100>;
            hold-trigger-key-positions = <40 41 42 59 58 57 0 1 2 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 52 53 54 55 56 3 43 44 45 60 61 62>;
            hold-trigger-on-release;
        };

        HRM_right_middy_v1: HRM_right_middy_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <40 41 42 59 58 57 0 1 2 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 52 53 54 55 56 3 43 44 45 60 61 62>;
            hold-trigger-on-release;
        };

        HRM_right_pinky_v1: HRM_right_pinky_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <40 41 42 59 58 57 0 1 2 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 52 53 54 55 56 3 43 44 45 60 61 62>;
            hold-trigger-on-release;
        };

        HRM_right_ring_v1: HRM_right_ring_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <40 41 42 59 58 57 0 1 2 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 52 53 54 55 56 3 43 44 45 60 61 62>;
            hold-trigger-on-release;
        };

        space_v1: space_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;

            flavor = "balanced";
            quick-tap-ms = <150>;
            retro-tap;
        };

        thumb_v1: thumb_v1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            bindings = <&mo>, <&kp>;

            flavor = "balanced";
            quick-tap-ms = <300>;
        };
    };

    // -------------------------------------------------------------------------
    // Combos
    // -------------------------------------------------------------------------

    combos {
        compatible = "zmk,combos";

        // Bottom thumb row pair.

        capsword {
            bindings = <&CAPSWord_v1 LSHIFT 0>;
            key-positions = <52 57>;
        };
    };

    // -------------------------------------------------------------------------
    // Macros
    // -------------------------------------------------------------------------

    macros {
        cur_UNDO_v1: cur_UNDO_v1 {
            label = "&CUR_UNDO_V1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(Z)>;
        };

        cur_REDO_v1: cur_REDO_v1 {
            label = "&CUR_REDO_V1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(Y)>;
        };

        battery_check: battery_check {
            label = "BATTERY_CHECK";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&rgb_ug RGB_COLOR_HSB(120,100,50)>,
                <&macro_pause_for_release>,
                <&rgb_ug RGB_TOG>;
        };
    };

    // -------------------------------------------------------------------------
    // Keymap
    // -------------------------------------------------------------------------

    keymap {
        compatible = "zmk,keymap";

        // Base typing layer. Thumb holds: symbols, numbers, system, and mouse/media.
        // ,-------------------------------------------------.                 ,-------------------------------------------------.
        // |   `   |   1   |   2   |   3   |   4   |   5   |                 |   6   |   7   |   8   |   9   |   0   |  PSCR |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // |  TAB  |   Q   |   W   |   E   |   R   |   T   |                 |   Y   |   U   |   I   |   O   |   P   |   \   |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // |  ESC  | GUI/A | ALT/S | CTL/D | SFT/F |   G   |                 |   H   | SFT/J | CTL/K | ALT/L | GUI/; |   '   |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // | LSHFT |   Z   |   X   |   C   |   V   |   B   |                 |   N   |   M   |   ,   |   .   |   /   | RSHFT |
        // `---------------+-------+-------+---------------'                 `---------------+-------+-------+---------------'
        //                 | LEFT  | RIGHT |                                                   |   [   |   ]   |
        //                 `---------------'                 ,-------------------------------. `---------------'
        //                                                   | LSHFT | LCTRL | LALT  | RALT  | RCTRL | RSHFT |
        //                                                   |-------+-------+-------+-------+-------+-------|
        //                                                   | SYM/B | NUM/D |  SYS  |  SYS  | M/E   | SYM/SP|
        //                                                   `-----------------------------------------------'

        base_layer {
            bindings = <
&kp GRAVE   &kp N1                     &kp N2                    &kp N3                      &kp N4                       &kp N5                              &kp N6         &kp N7                             &kp N8                       &kp N9                     &kp N0                         &kp PRINTSCREEN
&kp TAB     &kp Q                      &kp W                     &kp E                       &kp R                        &kp T                               &kp Y          &kp U                              &kp I                        &kp O                      &kp P                          &kp BSLH
&kp ESCAPE  &HRM_left_pinky_v1 LGUI A  &HRM_left_ring_v1 LALT S  &HRM_left_middy_v1 LCTRL D  &HRM_left_index_v1 LSHIFT F  &kp G                               &kp H          &HRM_right_index_v1 RIGHT_SHIFT J  &HRM_right_middy_v1 RCTRL K  &HRM_right_ring_v1 RALT L  &HRM_right_pinky_v1 RGUI SEMI  &kp SQT
&kp LSHFT   &kp Z                      &kp X                     &kp C                       &kp V                        &kp B                               &kp N          &kp M                              &kp COMMA                    &kp DOT                    &kp FSLH                       &kp RSHFT
                                       &kp LEFT                  &kp RIGHT                                                                                                                                      &kp LEFT_BRACKET             &kp RIGHT_BRACKET
                                                                                             &kp LEFT_SHIFT               &kp LCTRL           &kp LEFT_ALT    &kp RIGHT_ALT  &kp RIGHT_CONTROL                  &kp RIGHT_SHIFT
                                                                                             &thumb_v1 1 BACKSPACE        &thumb_v1 2 DELETE  &mo 3           &mo 3          &thumb_v1 4 ENTER                  &space_v1 1 SPACE
            >;
        };

        // Symbols on the left half. Right half keeps only basic edit/nav keys that are used.
        // ,-------------------------------------------------.                 ,-------------------------------------------------.
        // |   `   |   [   |   (   |   )   |   ]   |   +   |                 | trans | trans | trans | trans | trans | trans |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // |   ,   |   !   |   {   |   }   |   ;   |   ?   |                 | BSPC  |  DEL  | UNDO  | REDO  | trans | trans |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // |   #   |   ^   |   =   |   _   |   $   |   *   |                 | LEFT  | DOWN  |  UP   | RIGHT | trans | trans |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // |   ~   |   <   |   |   |   -   |   >   |   /   |                 | trans | trans | trans | trans | trans | trans |
        // `---------------+-------+-------+---------------'                 `---------------+-------+-------+---------------'
        //                 |   "   |   '   |                                                   | trans | trans |
        //                 `---------------'                 ,-------------------------------. `---------------'
        //                                                   |   &   |   .   | trans | trans | trans | trans |
        //                                                   |-------+-------+-------+-------+-------+-------|
        //                                                   |   %   |   :   |   @   | trans | trans | trans |
        //                                                   `-----------------------------------------------'

        symbols_layer {
            bindings = <
&kp GRAVE  &kp LBKT   &kp LPAR           &kp RPAR   &kp RBKT       &kp PLUS                  &trans    &trans    &trans        &trans        &trans  &trans
&kp COMMA  &kp EXCL   &kp LBRC           &kp RBRC   &kp SEMI       &kp QMARK                 &kp BSPC  &kp DEL   &cur_UNDO_v1  &cur_REDO_v1  &trans  &trans
&kp HASH   &kp CARET  &kp EQUAL          &kp UNDER  &kp DLLR       &kp ASTRK                 &kp LEFT  &kp DOWN  &kp UP        &kp RIGHT     &trans  &trans
&kp TILDE  &kp LT     &kp PIPE           &kp MINUS  &kp GT         &kp FSLH                  &trans    &trans    &trans        &trans        &trans  &trans
                      &kp DOUBLE_QUOTES  &kp SQT                                                                 &trans        &trans
                                                    &kp AMPERSAND  &kp DOT    &trans         &trans    &trans    &trans
                                                    &kp PRCNT      &kp COLON  &kp AT_SIGN    &trans    &trans    &trans
            >;
        };

        // Function keys across the top and numpad on the right half.
        // ,-------------------------------------------------.                 ,-------------------------------------------------.
        // | trans |  F1   |  F2   |  F3   |  F4   |  F5   |                 |  F6   |  F7   |  F8   |  F9   |  F10  |  F11  |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // | trans | trans | trans | trans | trans | trans |                 | trans |   7   |   8   |   9   | trans |  F12  |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // | trans | trans | trans | trans | trans | trans |                 | trans |   4   |   5   |   6   | trans | trans |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // | trans | trans | trans | trans | trans | trans |                 | trans |   1   |   2   |   3   | trans | trans |
        // `---------------+-------+-------+---------------'                 `---------------+-------+-------+---------------'
        //                 | trans | trans |                                                   | trans | trans |
        //                 `---------------'                 ,-------------------------------. `---------------'
        //                                                   | trans | trans | trans | trans | trans | trans |
        //                                                   |-------+-------+-------+-------+-------+-------|
        //                                                   | trans | trans | trans | trans |   0   |   .   |
        //                                                   `-----------------------------------------------'

        numbers_layer {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5            &kp F6  &kp F7  &kp F8   &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &kp N7  &kp N8   &kp N9  &trans   &kp F12
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &kp N4  &kp N5   &kp N6  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &kp N1  &kp N2   &kp N3  &trans   &trans
                &trans  &trans                                            &trans   &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &kp N0  &kp DOT
            >;
        };

        // Keyboard admin layer: Bluetooth, USB/BLE output, RGB, Studio, reset, and bootloader.
        // ,-------------------------------------------------.                 ,-------------------------------------------------.
        // |BT_CLR | BT 0  | BT 1  | BT 2  | BT 3  | BT 4  |                 |  USB  |  BLE  | BATT  |RGB_TOG|RGB_EFF| TO 0  |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // | trans | trans | trans | trans | trans | trans |                 | HUE+  | HUE-  | SAT+  | SAT-  | SPD+  | SPD-  |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // | trans | trans | trans | trans | trans |STUDIO |                 |STUDIO | BRI+  | BRI-  | trans | trans | trans |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // | BOOT  | trans | trans | trans | trans | RESET |                 | RESET | trans | trans | trans | trans | BOOT  |
        // `---------------+-------+-------+---------------'                 `---------------+-------+-------+---------------'
        //                 | trans | trans |                                                   | trans | trans |
        //                 `---------------'                 ,-------------------------------. `---------------'
        //                                                   | trans | trans | trans | trans | trans | trans |
        //                                                   |-------+-------+-------+-------+-------+-------|
        //                                                   | trans | trans | trans | trans | trans | trans |
        //                                                   `-----------------------------------------------'

        system_layer {
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4              &out OUT_USB     &out OUT_BLE     &battery_check   &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &to 0
&trans       &trans        &trans        &trans        &trans        &trans                    &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD
&trans       &trans        &trans        &trans        &trans        &studio_unlock            &studio_unlock   &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &trans           &trans           &trans
&bootloader  &trans        &trans        &trans        &trans        &sys_reset                &sys_reset       &trans           &trans           &trans           &trans           &bootloader
                           &trans        &trans                                                                                  &trans           &trans
                                                       &trans        &trans          &trans    &trans           &trans           &trans
                                                       &trans        &trans          &trans    &trans           &trans           &trans
            >;
        };

        // Auto-mouse layer: left half mouse buttons, right half media controls.
        // ,-------------------------------------------------.                 ,-------------------------------------------------.
        // | trans | trans | trans | trans | trans | trans |                 | trans | trans | trans | trans | trans | trans |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // | trans | trans | trans | trans | trans | trans |                 | trans | trans | trans | trans | trans | trans |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // | trans | trans | RCLK  | MCLK  | LCLK  | trans |                 | PREV  | PLAY  | NEXT  | trans | trans | trans |
        // |-------+-------+-------+-------+-------+-------|                 |-------+-------+-------+-------+-------+-------|
        // | trans | trans | trans | trans | trans | trans |                 | MUTE  | VOL-  | VOL+  | trans | trans | trans |
        // `---------------+-------+-------+---------------'                 `---------------+-------+-------+---------------'
        //                 | trans | trans |                                                   | trans | trans |
        //                 `---------------'                 ,-------------------------------. `---------------'
        //                                                   | trans | trans | trans | trans | trans | trans |
        //                                                   |-------+-------+-------+-------+-------+-------|
        //                                                   | trans | trans | trans | trans | trans | trans |
        //                                                   `-----------------------------------------------'

        mouse_media_layer {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans            &trans  &trans        &trans           &trans      &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans            &trans  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp K_MUTE  &trans  &trans
&trans  &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans            &trans  &kp C_PREV    &kp C_PP         &kp C_NEXT  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans            &trans  &trans        &trans           &trans      &trans  &trans
                &trans     &trans                                                        &trans           &trans
                                      &trans     &trans  &trans    &trans  &trans        &trans
                                      &trans     &trans  &trans    &trans  &trans        &trans
            >;
        };
    };
};

// -----------------------------------------------------------------------------
// Trackball Processing
// -----------------------------------------------------------------------------
// The central trackball scrolls by default.

&trackball_central_listener {
    input-processors =
        <&zip_xy_scaler 1 16>,
        <&zip_xy_to_scroll_mapper>,
        <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
};

// The peripheral trackball temporarily activates the mouse/media layer.

&trackball_peripheral_listener { input-processors = <&zip_temp_layer 4 500>; };
